# LANDING (server-khach) — chép tệp này thành `.env` cùng thư mục rồi điền,
# hoặc chạy `npm run install-wizard` để bộ cài hỏi và viết `.env`.
# `.env` KHÔNG vào git. Biến đặt sẵn trong môi trường đè lên tệp.
# Dòng bắt đầu bằng # là chưa đặt: bỏ dấu # khi cần. Đừng để trống một biến có mặc định
# (vd `TIEN_PHI_SHIP=` là phí ship 0) — muốn mặc định thì giữ dấu #.
# Không viết chú thích sau giá trị trên cùng dòng.

# ── Bắt buộc ─────────────────────────────────────────────────────────────
# Key cấp trên trang quản trị Xeon.
LICENSE_KEY=
XEON_DIA_CHI=https://xeon.toprun.vn
# Địa chỉ công khai của web shop; landing khai địa chỉ này với Xeon.
LANDING_SITE_BASE_URL=
# Cơ sở dữ liệu. Thiếu = chạy bằng tệp JSON, chỉ để thử.
# Landing TỰ NÉM nếu đường trỏ vào cổng 3306 (dữ liệu thật của landing đang chạy) — máy thử dùng 3307.
TOPRUN_MYSQL_URL=mysql://user:mat-khau@127.0.0.1:3307/ten_db

# ── Máy chủ ──────────────────────────────────────────────────────────────
PORT=4180
# THU_MUC_DU_LIEU=./du-lieu
# CHẾ ĐỘ THẬT: cho gửi tin khách / Telegram / tạo vận đơn thật. Thiếu = chế độ thử.
# CHE_DO_THAT=1
# TIN_PROXY=1
# PHIEN_HTTPS=1
# MODULE_BAT=hang-kho,don-khach,gian-hang
# DEPLOY_ID=
# GOC_ANH_THAT=https://toprun.site

# ── Mã truy cập (Desk, Image Tool, bộ não) ───────────────────────────────
LANDING_ADMIN_TOKEN=
# LANDING_ORDERS_TOKEN=
# IMAGE_TOOL_TOKEN=
# BO_NAO_TOKEN=
# Ký link gắn bài Facebook (tr_sig). Thiếu = vẫn đếm lượt xem, nhưng không quy được
# lượt nào về bài nào. Không đặt thì dùng LANDING_ORDERS_TOKEN.
# TOPRUN_ATTRIBUTION_SECRET=

# ── Phiên đăng nhập (bí mật >= 16 ký tự; bộ cài tự sinh) ─────────────────
BI_MAT_PHIEN_DOI_TAC=
BI_MAT_PHIEN_CTV=

# ── Quản trị web /admin (tài khoản NGƯỜI, không phải mã máy) ─────────────
# Chủ shop ĐẦU TIÊN — chỉ đọc khi chưa có ai trong bảng quan_tri_nguoi; sau đó quản lý
# người ngay trên màn quản trị. Chuyển từ web cũ: chép nguyên ADMIN_LOGIN + ADMIN_PASSWORD_HASH
# của web cũ là đăng nhập được bằng mật khẩu đang dùng. Máy đầu tiên của chủ shop tự được duyệt.
# ADMIN_LOGIN=admin
# ADMIN_PASSWORD_HASH=pbkdf2$210000$...
# ADMIN_PASSWORD=        (hoặc mật khẩu thường, >= 8 ký tự)
# PHIEN_QUAN_TRI_NGAY=14
# Quét tem bằng camera ở cổng đối tác: khoá AI đọc ảnh tem (gateway kiểu OpenAI).
# Thiếu = nút quét báo "chưa bật", đối tác vẫn gõ tay bình thường.
# SCAN_AI_API_KEY=
# SCAN_AI_BASE_URL=https://ai.elevenvoice.site/v1
# SCAN_AI_MODEL=ag/gemini-3.7-flash-low
# PHIEN_DOI_TAC_GIO=12
# PHIEN_CTV_GIO=720
# PHIEN_KHACH_NGAY=30
# LINK_KHACH_PHUT=30

# ── E-mail cho khách (quên mật khẩu, xác thực hồ sơ) ─────────────────────
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM=

# ── Tiền ─────────────────────────────────────────────────────────────────
# TIEN_PHAN_TRAM_COC=30
# TIEN_PHI_SHIP=30000
# TIEN_TIEN_TO_CK=TR

# ── Báo cho người bán hàng ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Kho (người gửi trên vận đơn) ─────────────────────────────────────────
KHO_TEN=
KHO_DIEN_THOAI=
KHO_TINH=
KHO_HUYEN=
KHO_XA=
KHO_DIA_CHI=

# ── Vận chuyển ───────────────────────────────────────────────────────────
# VAN_CHUYEN_MAC_DINH=spx
SPX_APP_ID=
SPX_APP_SECRET=
SPX_USER_ID=
SPX_USER_SECRET=
VTP_TOKEN=
VTP_USERNAME=
VTP_PASSWORD=
VTP_GROUP_ADDRESS_ID=

# ── Fanpage (webhook Meta) ───────────────────────────────────────────────
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_TOKEN=
