{
  "name": "@sp/landing",
  "version": "0.2.0",
  "private": true,
  "description": "The merchant's own server (landing): keeps the shop's data, serves the storefront, opens APIs for OMI and the brain, receives Fanpage messages.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "check": "tsc -p tsconfig.check.json && tsc -p tsconfig.test.json",
    "clean": "tsc --build --clean",
    "start": "node dist/main.js",
    "install-wizard": "node dist/tools/install.js",
    "test": "npm run build && node --test --test-timeout=60000 --test-force-exit \"test/*.test.mts\"",
    "test:mysql": "npm run build && node --test --test-concurrency=1 --test-timeout=90000 --test-force-exit \"test-mysql/*.test.mts\""
  },
  "dependencies": {
    "mysql2": "^3.24.4",
    "nodemailer": "^7.0.13"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
